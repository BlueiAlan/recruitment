{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:/WorkSpace/project/Recruitment"
      ],
      "env": {
        "MCP_FILESYSTEM_READONLY": "false"
      }
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git",
        "D:/WorkSpace/project/Recruitment"
      ]
    }
  },
  "policies": {
    "requireReviewForWrite": true,
    "preferReadOnly": false,
    "audit": {
      "enabled": true,
      "retentionDays": 30
    }
  }
}
